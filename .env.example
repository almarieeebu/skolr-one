# Leave these empty to run in DEMO MODE (in-memory data, role switcher).
# Fill them in to use your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, SERVER ONLY (never NEXT_PUBLIC_): lets the online enrollment form
# (/apply) make applicant accounts without an email. Without it, applicants
# must give an email and confirm it (Supabase signUp). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
